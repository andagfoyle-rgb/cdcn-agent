# ── Ollama (R710 LAN) ─────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://192.168.x.x:11434
OLLAMA_MODEL=llama3.1:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_API_KEY=                          # optional bearer token for Ollama reverse proxy

# ── Ollama (Pi 5 local / Dream mode) ─────────────────────────────────────────
DREAM_OLLAMA_BASE_URL=http://127.0.0.1:11434
DREAM_MODEL=phi3:mini

# ── Wake / Sleep schedule ────────────────────────────────────────────────────
WAKE_START_TIME=07:00
WAKE_END_TIME=22:00
JOURNAL_TIME=21:45
HEARTBEAT_INTERVAL_HOURS=6

# ── Wake-on-LAN (R710) ───────────────────────────────────────────────────────
WAKEONLAN_MAC=                           # R710 MAC address e.g. AA:BB:CC:DD:EE:FF
WAKEONLAN_BROADCAST=192.168.1.255
WAKEONLAN_BOOT_WAIT_SECS=180

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=              # comma-separated int IDs
TELEGRAM_NOTIFICATION_CHAT_ID=

# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNEL_IDS=           # comma-separated channel IDs
DISCORD_ALLOWED_ROLE_NAMES=            # comma-separated role names
DISCORD_STATUS_CHANNEL_ID=

# ── Auth ─────────────────────────────────────────────────────────────────────
SECRET_KEY=                             # long random secret for JWT signing
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=                    # bcrypt hash of admin password

# ── Gateway ──────────────────────────────────────────────────────────────────
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_PORT=8400
ALLOW_PUBLIC_BIND=false                 # set true only if you need 0.0.0.0 (not recommended)

# ── Storage paths ────────────────────────────────────────────────────────────
WATCHED_FOLDER=data/documents
CHROMA_PATH=data/chroma
MEMORY_PATH=data/memory
AUDIT_LOG_PATH=data/cdcn_audit.db
PENDING_CHANGES_PATH=skills_config/pending_changes
