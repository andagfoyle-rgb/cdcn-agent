_JS = r"""
(function () {
'use strict';
var wsUrl = (location.protocol === 'https:' ? 'wss:' : 'ws:') + '//' + location.host + '/ws';
var ws = null;
var currentUsername = document.body.dataset.username;
var currentDisplay = document.body.dataset.display;
var currentRole = document.body.dataset.role;
var agentEl = null;
var shownIds = new Set();
var agentContent = '';
var messages = document.getElementById('messages');
var input = document.getElementById('input');
var sendBtn = document.getElementById('send-btn');
var uploadInput = document.getElementById('upload-input');
var typingEl = document.getElementById('typing-indicator');

function ts() {
  return new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
}
function escHtml(str) {
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function roleBadge(role) {
  var cls = role === 'admin' ? 'admin' : (role === 'staff' ? 'staff' : '');
  return '<span class="role-badge ' + cls + '">' + escHtml(role) + '</span>';
}
function appendMsg(type, displayName, role, content, isMe) {
  var div = document.createElement('div');
  if (type === 'system') {
    div.className = 'msg system-msg';
    div.innerHTML = '<div class="msg-bubble">' + escHtml(content) + '</div>';
  } else {
    div.className = 'msg ' + (type === 'agent' ? 'agent' : (isMe ? 'user-me' : 'user-other'));
    var meta = '<div class="msg-meta">' +
      (isMe ? '' : '<strong>' + escHtml(displayName) + '</strong>' + roleBadge(role)) +
      '<span>' + ts() + '</span>' +
      (isMe ? roleBadge(role) : '') +
      '</div>';
    div.innerHTML = meta + '<div class="msg-bubble">' + escHtml(content) + '</div>';
  }
  messages.appendChild(div);
  messages.scrollTop = messages.scrollHeight;
  return div;
}
function appendHistoryMsg(msg) {
  if (msg.id && shownIds.has(msg.id)) return;
  if (msg.id) shownIds.add(msg.id);
  var isMe = msg.username === currentUsername;
  var type = msg.msg_type;
  var displayName = msg.display_name || msg.username;
  var div = document.createElement('div');
  if (type === 'system') {
    div.className = 'msg system-msg';
    div.innerHTML = '<div class="msg-bubble">' + escHtml(msg.content) + '</div>';
  } else {
    div.className = 'msg ' + (type === 'agent' ? 'agent' : (isMe ? 'user-me' : 'user-other'));
    var tstr = new Date(msg.ts).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
    var meta = '<div class="msg-meta">' +
      (isMe ? '' : '<strong>' + escHtml(displayName) + '</strong>' + roleBadge(msg.role)) +
      '<span>' + tstr + '</span>' +
      (isMe ? roleBadge(msg.role) : '') +
      '</div>';
    div.innerHTML = meta + '<div class="msg-bubble">' + escHtml(msg.content) + '</div>';
  }
  messages.appendChild(div);
}
function updateOnlineUsers(users) {
  var el = document.getElementById('online-users');
  if (!el) return;
  var names = users.map(function(u) { return escHtml(u.display_name || u.username); });
  el.innerHTML = 'Online: ' + (names.length ? names.join(', ') : 'just you');
}
function renderPoll(pollData) {
  var div = document.createElement('div');
  div.className = 'msg agent';
  div.innerHTML = '<div class="msg-meta"><strong>CDCN Agent</strong><span>' + ts() + '</span></div>';
  var widget = document.createElement('div');
  widget.className = 'poll-widget';
  widget.dataset.pollId = pollData.id;
  widget.dataset.pollType = pollData.poll_type;
  var typeLabel = pollData.poll_type === 'multi_select' ? 'Select all that apply' : 'Select one';
  var totalVotes = pollData.response_count || 0;
  var html = '<div class="poll-type-badge">' + typeLabel + '</div>';
  html += '<div class="poll-question">' + escHtml(pollData.question) + '</div>';
  pollData.options.forEach(function(opt) {
    var count = (pollData.results && pollData.results[opt]) || 0;
    var pct = totalVotes > 0 ? Math.round(count / totalVotes * 100) : 0;
    var inputType = pollData.poll_type === 'multi_select' ? 'checkbox' : 'radio';
    html += '<label class="poll-option">' +
      '<input type="' + inputType + '" name="poll_' + pollData.id + '" value="' + escHtml(opt) + '">' +
      '<span>' + escHtml(opt) + '</span>' +
      '<div class="poll-bar"><div class="poll-bar-fill" style="width:' + pct + '%"></div></div>' +
      '<span class="poll-count">' + count + '</span></label>';
  });
  html += '<div style="margin-top:.75rem"><button class="btn btn-primary btn-sm" onclick="submitPoll(' + pollData.id + ')">Submit</button></div>';
  widget.innerHTML = html;
  div.appendChild(widget);
  messages.appendChild(div);
  messages.scrollTop = messages.scrollHeight;
}
window.submitPoll = function(pollId) {
  var widget = document.querySelector('[data-poll-id="' + pollId + '"]');
  var inputs = widget.querySelectorAll('input:checked');
  var responses = Array.from(inputs).map(function(i) { return i.value; });
  if (!responses.length) { alert('Please select an option.'); return; }
  fetch('/api/polls/' + pollId + '/vote', {
    method: 'POST', headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({responses: responses})
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (data.success) {
      widget.querySelector('[style*="margin-top"]').innerHTML = '<em style="color:#16a34a">Vote recorded \u2714</em>';
    }
  });
};
function connectWS() {
  ws = new WebSocket(wsUrl);
  var pingInterval = null;
  ws.onopen = function() {
    setInputEnabled(true);
    if (pingInterval) clearInterval(pingInterval);
    pingInterval = setInterval(function() {
      if (ws && ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ping: true}));
    }, 15000);
    fetch('/api/history').then(function(r) { return r.json(); }).then(function(data) {
      data.forEach(appendHistoryMsg);
      messages.scrollTop = messages.scrollHeight;
    });
    fetch('/api/polls').then(function(r) { return r.json(); }).then(function(polls) {
      polls.forEach(renderPoll);
    });
  };
  ws.onclose = function() {
    setInputEnabled(false);
    if (pingInterval) { clearInterval(pingInterval); pingInterval = null; }
    setTimeout(connectWS, 3000);
  };
  ws.onerror = function() { ws.close(); };
  ws.onmessage = function(event) {
    var data = JSON.parse(event.data);
    if (data.type === 'token') {
      if (!agentEl) {
        agentEl = document.createElement('div');
        agentEl.className = 'msg agent';
        agentEl.innerHTML = '<div class="msg-meta"><strong>CDCN Agent</strong><span>' + ts() + '</span></div><div class="msg-bubble"></div>';
        messages.appendChild(agentEl);
        agentContent = '';
        typingEl.style.display = 'none';
      }
      agentContent += data.content;
      agentEl.querySelector('.msg-bubble').textContent = agentContent;
      messages.scrollTop = messages.scrollHeight;
    } else if (data.type === 'done') {
      if (agentEl && agentContent) {
        var finalContent = agentContent;
        agentEl = null; agentContent = '';
        fetch('/api/save_agent_message', {
          method: 'POST', headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({content: finalContent})
        });
      }
      setInputEnabled(true);
      typingEl.style.display = 'none';
    } else if (data.type === 'user_message') {
      if (data.username !== currentUsername) {
        appendMsg('user', data.display_name || data.username, data.role, data.content, false);
      }
    } else if (data.type === 'system') {
      appendMsg('system', '', '', data.content);
    } else if (data.type === 'online_users') {
      updateOnlineUsers(data.users);
    } else if (data.type === 'poll') {
      renderPoll(data.poll);
    } else if (data.type === 'error') {
      appendMsg('system', '', '', 'Error: ' + (data.detail || 'unknown'));
      setInputEnabled(true);
      typingEl.style.display = 'none';
    }
  };
}
connectWS();

function setInputEnabled(enabled) {
  input.disabled = !enabled;
  sendBtn.disabled = !enabled;
  if (enabled) input.focus();
}

function sendMessage() {
  var text = input.value.trim();
  if (!text || !ws || ws.readyState !== WebSocket.OPEN) return;
  appendMsg('user', currentDisplay, currentRole, text, true);
  ws.send(JSON.stringify({message: text}));
  input.value = '';
  setInputEnabled(false);
  typingEl.style.display = 'block';
  typingEl.textContent = 'CDCN Agent is thinking…';
  agentEl = null; agentContent = '';
}

sendBtn.addEventListener('click', sendMessage);
input.addEventListener('keydown', function(e) {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
});

uploadInput.addEventListener('change', function() {
  if (!uploadInput.files.length) return;
  uploadFiles(uploadInput.files);
  uploadInput.value = '';
});

function uploadFiles(files) {
  var fd = new FormData();
  var names = [];
  Array.from(files).forEach(function(f) { fd.append('files', f); names.push(f.name); });
  appendMsg('system', '', '', 'Uploading: ' + names.join(', ') + '...');
  fetch('/upload', {method: 'POST', body: fd})
    .then(function(r) { return r.json(); })
    .then(function(data) { appendMsg('system', '', '', data.message || 'Upload complete.'); })
    .catch(function() { appendMsg('system', '', '', 'Upload failed.'); });
}

var dragOverlay = document.getElementById('drag-overlay');
var dragCount = 0;
document.addEventListener('dragenter', function(e) {
  e.preventDefault(); dragCount++; dragOverlay.classList.add('active');
});
document.addEventListener('dragleave', function() {
  dragCount--;
  if (dragCount <= 0) { dragCount = 0; dragOverlay.classList.remove('active'); }
});
document.addEventListener('dragover', function(e) { e.preventDefault(); });
document.addEventListener('drop', function(e) {
  e.preventDefault(); dragCount = 0; dragOverlay.classList.remove('active');
  if (e.dataTransfer.files.length) uploadFiles(e.dataTransfer.files);
});

function pollStatus() {
  fetch('/api/status').then(function(r) { return r.json(); }).then(function(s) {
    var badge = document.getElementById('status-badge');
    if (badge) {
      var mode = (s.mode || 'unknown').replace(/_/g, '-');
      badge.textContent = mode;
      badge.className = 'status-badge ' + (s.mode || 'unknown');
    }
  }).catch(function(){});
}
pollStatus();
setInterval(pollStatus, 30000);
}());
"""

def _login_html(error=""):
    err = f'<div class="error">{error}</div>' if error else ""
    return f"""<!DOCTYPE html><html lang="en"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>CDCN Agent</title><style>{_CSS}</style></head>
<body><div class="auth-page"><div class="auth-box">
<h1>CDCN Agent</h1>{err}
<form method="post" action="/login">
<div class="form-group"><label>Username</label>
<input type="text" name="username" required autofocus></div>
<div class="form-group"><label>Password</label>
<input type="password" name="password" required></div>
<div class="form-actions"><button type="submit" class="btn btn-primary">Sign in</button></div>
</form>
<div class="auth-link"><a href="/register">Request access</a></div>
</div></div></body></html>"""

def _register_html(error="", success=""):
    err = f'<div class="error">{error}</div>' if error else ""
    suc = f'<div class="success">{success}</div>' if success else ""
    return f"""<!DOCTYPE html><html lang="en"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>CDCN Agent — Request Access</title><style>{_CSS}</style></head>
<body><div class="auth-page"><div class="auth-box">
<h1>Request Access</h1>{err}{suc}
<form method="post" action="/register">
<div class="form-group"><label>Full name</label>
<input type="text" name="display_name" required></div>
<div class="form-group"><label>Email</label>
<input type="email" name="email" required></div>
<div class="form-group"><label>Username</label>
<input type="text" name="username" required></div>
<div class="form-group"><label>Password</label>
<input type="password" name="password" required></div>
<div class="form-group"><label>Reason for access</label>
<textarea name="reason" rows="3" placeholder="Please explain your role with CDCN..."></textarea></div>
<div class="form-actions"><button type="submit" class="btn btn-primary">Submit request</button></div>
</form>
<div class="auth-link"><a href="/login">Back to login</a></div>
</div></div></body></html>"""

def _chat_html(username, display_name, role, is_admin):
    admin_link = '<a href="/admin">Admin</a>' if is_admin else ""
    return f"""<!DOCTYPE html><html lang="en"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>CDCN Agent</title><style>{_CSS}</style></head>
<body data-username="{username}" data-display="{display_name}" data-role="{role}">
<div class="drag-overlay" id="drag-overlay">&#128194; Drop files to upload</div>
<div class="header">
  <h1>CDCN Agent</h1>
  <span class="status-badge" id="status-badge">&#8230;</span>
  <span class="online-users" id="online-users"></span>
  <div class="header-actions">{admin_link}<a href="/logout">Sign out ({display_name})</a></div>
</div>
<div class="main"><div class="messages-wrap">
  <div class="messages" id="messages"></div>
  <div class="typing" id="typing-indicator" style="display:none"></div>
  <div class="input-area">
    <textarea id="input" rows="2" placeholder="Message CDCN Agent&#8230; (Enter to send, Shift+Enter for new line)" disabled></textarea>
    <label class="btn-icon" title="Upload document">&#128206;
      <input type="file" id="upload-input" accept=".pdf,.docx,.txt,.md" multiple>
    </label>
    <button class="btn btn-primary" id="send-btn" disabled>Send</button>
  </div>
</div></div>
<script>{_JS}</script></body></html>"""

def _admin_html(pending, users, current_user):
    pending_rows = ""
    for r in pending:
        pending_rows += f"""<tr>
<td>{r['display_name']}</td><td>{r['username']}</td><td>{r['email']}</td>
<td>{r.get('reason','')}</td><td>{r['created_at'][:10]}</td>
<td class="action-btns">
<form method="post" action="/admin/approve" style="display:inline">
<input type="hidden" name="request_id" value="{r['id']}">
<select name="role"><option value="staff">Staff</option><option value="admin">Admin</option><option value="trustee">Observer</option></select>
<button type="submit" class="btn btn-sm btn-approve">Approve</button></form>
<form method="post" action="/admin/reject" style="display:inline">
<input type="hidden" name="request_id" value="{r['id']}">
<input type="text" name="reason" placeholder="Reason (optional)" style="width:120px;font-size:.8rem;padding:.2rem .4rem;border:1px solid #ccc;border-radius:4px">
<button type="submit" class="btn btn-sm btn-reject">Reject</button></form>
</td></tr>"""
    user_rows = ""
    for u in users:
        if u['username'] == current_user:
            continue
        status = u.get('status', 'active') or ('active' if u.get('active', 1) else 'suspended')
        status_badge = f'<span class="badge badge-{status}">{status}</span>'
        actions = ""
        if u.get('active', 1):
            actions += f'<form method="post" action="/admin/suspend" style="display:inline"><input type="hidden" name="username" value="{u["username"]}"><button type="submit" class="btn btn-sm btn-suspend">Suspend</button></form>'
            actions += f'<form method="post" action="/admin/role" style="display:inline"><input type="hidden" name="username" value="{u["username"]}"><select name="role"><option value="staff">Staff</option><option value="admin">Admin</option><option value="trustee">Observer</option></select><button type="submit" class="btn btn-sm btn-reactivate">Set role</button></form>'
        else:
            actions += f'<form method="post" action="/admin/reactivate" style="display:inline"><input type="hidden" name="username" value="{u["username"]}"><button type="submit" class="btn btn-sm btn-reactivate">Reactivate</button></form>'
        user_rows += f"<tr><td>{u.get('display_name') or u['username']}</td><td>{u['username']}</td><td>{u['role']}</td><td>{status_badge}</td><td class='action-btns'>{actions}</td></tr>"
    no_pending = '<p style="color:#888;font-size:.9rem">No pending requests.</p>'
    pending_table = f'<table class="user-table"><thead><tr><th>Name</th><th>Username</th><th>Email</th><th>Reason</th><th>Date</th><th>Actions</th></tr></thead><tbody>{pending_rows}</tbody></table>' if pending else no_pending
    return f"""<!DOCTYPE html><html lang="en"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>CDCN Agent — Admin</title><style>{_CSS}</style></head>
<body><div class="admin-page">
<a href="/" class="back-link">&#8592; Back to chat</a>
<h1>Admin Panel</h1>
<div class="admin-section"><h2>Pending Registrations ({len(pending)})</h2>{pending_table}</div>
<div class="admin-section"><h2>Users</h2>
<table class="user-table"><thead><tr><th>Name</th><th>Username</th><th>Role</th><th>Status</th><th>Actions</th></tr></thead>
<tbody>{user_rows}</tbody></table></div>
</div></body></html>"""

@web_router.get("/login", response_class=HTMLResponse)
async def login_form():
    return HTMLResponse(_login_html())

@web_router.post("/login")
async def login_submit(request: Request):
    form = await request.form()
    username = str(form.get("username", "")).strip()
    password = str(form.get("password", ""))
    user = authenticate_user(username, password)
    if not user:
        return HTMLResponse(_login_html(error="Invalid username or password."), status_code=401)
    token = create_access_token(user)
    resp = RedirectResponse(url="/", status_code=303)
    resp.set_cookie(key="access_token", value=token, httponly=True, samesite="lax", max_age=28800)
    return resp

@web_router.get("/logout")
async def logout():
    resp = RedirectResponse(url="/login", status_code=303)
    resp.delete_cookie("access_token")
    return resp

@web_router.get("/register", response_class=HTMLResponse)
async def register_form():
    return HTMLResponse(_register_html())

@web_router.post("/register")
async def register_submit(request: Request):
    form = await request.form()
    username = str(form.get("username", "")).strip()
    password = str(form.get("password", ""))
    display_name = str(form.get("display_name", "")).strip()
    email = str(form.get("email", "")).strip()
    reason = str(form.get("reason", "")).strip()
    if not all([username, password, display_name, email]):
        return HTMLResponse(_register_html(error="All fields are required."))
    try:
        register_user(username, password, display_name, email, "staff", reason)
        await _broadcast_system(f"New registration request from {display_name} — review in Admin Panel.")
        return HTMLResponse(_register_html(success="Your request has been submitted. An administrator will review it shortly."))
    except ValueError as e:
        return HTMLResponse(_register_html(error=str(e)))

@web_router.get("/", response_class=HTMLResponse)
async def chat_ui(request: Request):
    user = _get_user_from_cookie(request)
    if not user:
        return RedirectResponse(url="/login", status_code=303)
    is_admin = has_permission(user.role, "add_users")
    dn = user.username
    try:
        conn = sqlite3.connect(_user_db())
        conn.row_factory = sqlite3.Row
        row = conn.execute("SELECT display_name FROM users WHERE username = ?", (user.username,)).fetchone()
        conn.close()
        if row and row["display_name"]:
            dn = row["display_name"]
    except Exception:
        pass
    return HTMLResponse(_chat_html(user.username, dn, user.role, is_admin))

@web_router.get("/admin", response_class=HTMLResponse)
async def admin_page(request: Request):
    user = _get_user_from_cookie(request)
    if not user or not has_permission(user.role, "add_users"):
        return RedirectResponse(url="/", status_code=303)
    pending = get_pending_registrations()
    users = list_users()
    return HTMLResponse(_admin_html(pending, users, user.username))

@web_router.post("/admin/approve")
async def admin_approve(request: Request):
    user = _get_user_from_cookie(request)
    if not user or not has_permission(user.role, "add_users"):
        return RedirectResponse(url="/", status_code=303)
    form = await request.form()
    request_id = int(form.get("request_id", 0))
    role = str(form.get("role", "staff"))
    try:
        new_user = approve_registration(request_id, user.username, role)
        await _broadcast_system(f"Registration approved: {new_user.username} can now log in as {role}.")
    except ValueError as e:
        log.warning("Approve failed: %s", e)
    return RedirectResponse(url="/admin", status_code=303)

