"""
Web interface — multi-user chat room with registration, admin panel, polls.
"""
from __future__ import annotations
import asyncio, json, logging, sqlite3
from datetime import datetime, timezone
from pathlib import Path
from typing import Optional
import aiosqlite
from fastapi import APIRouter, Request, Response, WebSocket, WebSocketDisconnect
from fastapi.responses import HTMLResponse, JSONResponse, RedirectResponse
from app.auth.auth import (
    ALGORITHM, authenticate_user, create_access_token, verify_token,
    register_user, get_pending_registrations, approve_registration,
    reject_registration, list_users, update_user_role, suspend_user,
    reactivate_user, has_permission,
)
from app.config import settings
from app.interfaces.base_adapter import BaseAdapter
log = logging.getLogger(__name__)
web_router = APIRouter()
_active_ws: dict[str, WebSocket] = {}
_user_display: dict[str, str] = {}
_user_roles: dict[str, str] = {}
def _audit_db(): return settings.audit_log_path
def _user_db(): return str(Path(settings.audit_log_path).parent / "users.db")
def _get_user_from_cookie(r):
    t = r.cookies.get("access_token")
    return verify_token(t) if t else None

async def _save_message(username, display_name, role, msg_type, content):
    ts = datetime.now(timezone.utc).isoformat()
    async with aiosqlite.connect(_audit_db()) as conn:
        await conn.execute(
            "INSERT INTO shared_messages (ts, username, display_name, role, msg_type, content)"
            " VALUES (?, ?, ?, ?, ?, ?)",
            (ts, username, display_name, role, msg_type, content),
        )
        await conn.commit()

async def _get_history(limit=100):
    async with aiosqlite.connect(_audit_db()) as conn:
        conn.row_factory = aiosqlite.Row
        async with conn.execute(
            "SELECT * FROM shared_messages ORDER BY id DESC LIMIT ?", (limit,)
        ) as cur:
            rows = await cur.fetchall()
    return [dict(r) for r in reversed(rows)]

async def _broadcast(msg):
    dead = []
    for username, ws in list(_active_ws.items()):
        try:
            await ws.send_text(json.dumps(msg))
        except Exception:
            dead.append(username)
    for u in dead:
        _active_ws.pop(u, None)
        _user_display.pop(u, None)
        _user_roles.pop(u, None)

async def _broadcast_system(content, save=True):
    if save:
        await _save_message("system", "System", "system", "system", content)
    await _broadcast({"type": "system", "content": content})

async def _broadcast_user_msg(username, display_name, role, content):
    await _save_message(username, display_name, role, "user", content)
    await _broadcast({
        "type": "user_message", "username": username,
        "display_name": display_name, "role": role, "content": content,
        "ts": datetime.now(timezone.utc).isoformat(),
    })

async def _broadcast_online():
    users = [
        {"username": u, "display_name": _user_display.get(u, u), "role": _user_roles.get(u, "")}
        for u in _active_ws
    ]
    await _broadcast({"type": "online_users", "users": users})

async def _get_open_polls():
    async with aiosqlite.connect(_audit_db()) as conn:
        conn.row_factory = aiosqlite.Row
        async with conn.execute(
            "SELECT p.*, (SELECT COUNT(*) FROM poll_responses WHERE poll_id = p.id) as response_count"
            " FROM polls p WHERE p.status = 'open' ORDER BY p.id DESC"
        ) as cur:
            polls = [dict(r) for r in await cur.fetchall()]
        for poll in polls:
            poll["options"] = json.loads(poll["options"])
            async with conn.execute(
                "SELECT response, COUNT(*) as count FROM poll_responses"
                " WHERE poll_id = ? GROUP BY response", (poll["id"],),
            ) as cur:
                results = await cur.fetchall()
            poll["results"] = {r["response"]: r["count"] for r in results}
    return polls

