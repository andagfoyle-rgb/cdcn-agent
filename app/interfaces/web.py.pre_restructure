  <script>
{_SIDEBAR_JS}

var calYear, calMonth, calEvents=[], canEdit={'true' if can_edit else 'false'};
var MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
var CAT_COLORS = {{
