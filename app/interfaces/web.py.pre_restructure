  var remainder = totalCells % 7;
  if (remainder > 0) {{
    for (var i = 0; i < 7 - remainder; i++) {{
      html += '<div style="padding:.5rem;min-height:80px;border:1px solid var(--border);background:var(--surface-2);opacity:.3;border-radius:var(--radius-sm);"></div>';
