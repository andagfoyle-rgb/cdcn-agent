  --border: #3a3f4a;
  --border-light: #2d3139;
  --text-primary: #e2e8f0;
  --text-secondary: #a0aec0;
  --text-muted: #5a6577;
  --text-bubble-me: #ffffff;
  --text-header: #e2e8f0;
  --text-link: #5EAFE5;
  --badge-admin-bg: #44381f;
  --badge-admin-text: #fbbf24;
  --badge-staff-bg: #1e3a5f;
  --badge-staff-text: #7db5f0;
  --badge-default-bg: #3a3f4a;
  --badge-default-text: #a0aec0;
  --file-link-bg: #1e3a5f;
