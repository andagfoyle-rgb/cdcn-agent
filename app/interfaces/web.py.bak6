.btn-sm { padding: .3rem .65rem; font-size: .78rem; border-radius: 5px; border: none;
          cursor: pointer; font-family: var(--font); }
.btn-approve { background: #22c55e; color: white; }
.btn-reject { background: var(--norse-red); color: white; }
.btn-suspend { background: #f59e0b; color: white; }
