@web_router.get("/api/all_users")
async def api_all_users():
    from app.auth.auth import list_users
    all_u = list_users()
    return JSONResponse([
        {"username": u["username"], "display_name": u.get("display_name", u["username"]),
         "role": u.get("role", ""), "status": u.get("status", "")}
        for u in all_u if u.get("status") == "active"
    ])

@web_router.get("/files/{filename:path}")
async def serve_document(filename: str):
    import urllib.parse
    from starlette.responses import FileResponse
    doc_dir = Path("/var/lib/cdcn-agent/documents")
    safe_name = urllib.parse.unquote(filename)
    file_path = (doc_dir / safe_name).resolve()
    if not str(file_path).startswith(str(doc_dir)):
        return JSONResponse({"error": "invalid path"}, status_code=400)
    if not file_path.exists():
        return JSONResponse({"error": "file not found"}, status_code=404)
    return FileResponse(file_path, filename=safe_name, media_type="application/octet-stream")

@web_router.get("/api/status")
async def api_status():
    try:
        from app.state_manager import get_state_manager
        sm = get_state_manager()
        return JSONResponse({"mode": sm.current_state, "ok": True})
    except Exception:
        return JSONResponse({"mode": "unknown", "ok": False})

@web_router.get("/api/polls")
async def api_polls(request: Request):
    user = _get_user_from_cookie(request)
    if not user:
        return JSONResponse([])
    return JSONResponse(await _get_open_polls())

@web_router.post("/api/polls")
async def api_create_poll(request: Request):
    user = _get_user_from_cookie(request)
    if not user:
        return JSONResponse({"error": "unauthorised"}, status_code=401)
    data = await request.json()
    question = str(data.get("question", "")).strip()
    options = data.get("options", [])
    poll_type = str(data.get("poll_type", "single_select"))
    if not question or len(options) < 2:
        return JSONResponse({"error": "question and at least 2 options required"}, status_code=400)
    ts = datetime.now(timezone.utc).isoformat()
    async with aiosqlite.connect(_audit_db()) as conn:
        cur = await conn.execute(
            "INSERT INTO polls (ts, created_by, question, options, poll_type, status) VALUES (?, ?, ?, ?, ?, 'open')",
            (ts, user.username, question, json.dumps(options), poll_type),
        )
        poll_id = cur.lastrowid
        await conn.commit()
    polls = await _get_open_polls()
    poll = next((p for p in polls if p["id"] == poll_id), None)
    if poll:
        await _broadcast({"type": "poll", "poll": poll})
    return JSONResponse({"success": True, "poll_id": poll_id})

@web_router.post("/api/polls/{poll_id}/vote")
async def api_vote(request: Request, poll_id: int):
    user = _get_user_from_cookie(request)
    if not user:
        return JSONResponse({"error": "unauthorised"}, status_code=401)
    data = await request.json()
    responses = data.get("responses", [])
    ts = datetime.now(timezone.utc).isoformat()
    async with aiosqlite.connect(_audit_db()) as conn:
        for r in responses:
            await conn.execute(
                "INSERT INTO poll_responses (ts, poll_id, username, response) VALUES (?, ?, ?, ?)",
                (ts, poll_id, user.username, r),
            )
        await conn.commit()
    return JSONResponse({"success": True})

@web_router.post("/api/save_agent_message")
async def api_save_agent(request: Request):
    user = _get_user_from_cookie(request)
    if not user:
        return JSONResponse({"ok": False})
    data = await request.json()
    content = str(data.get("content", ""))
    if content:
        await _save_message("agent", "CDCN Agent", "agent", "agent", content)
    return JSONResponse({"ok": True})

@web_router.post("/upload")
async def upload_documents(request: Request):
    user = _get_user_from_cookie(request)
    if not user:
        return JSONResponse({"error": "unauthorised"}, status_code=401)
    docs_dir = Path(settings.watched_folder)
    docs_dir.mkdir(parents=True, exist_ok=True)
    form = await request.form()
    saved = []
    for field in form.values():
        if hasattr(field, "filename") and field.filename:
            dest = docs_dir / field.filename
            data = await field.read()
            if len(data) == 0:
                continue
            with dest.open("wb") as fh:
                fh.write(data)
            saved.append(field.filename)
    if saved:
        display = _user_display.get(user.username, user.username)
        await _broadcast_system(f"{display} uploaded: {', '.join(saved)} — indexing now...")
        try:
            from app.skills.indexer import IndexerSkill
            indexer = IndexerSkill()
            result = await indexer.run({})
            indexed = result.metadata.get("indexed", 0) if result.success else 0
            await _broadcast_system(f"Indexing complete: {indexed} file(s) added to archive.")
        except Exception as e:
            log.warning("Indexer failed after upload: %s", e)
            await _broadcast_system("Indexing failed — please retry manually.")
        return JSONResponse({"message": f"Uploaded: {', '.join(saved)}"})
    return JSONResponse({"message": "No files received."})

@web_router.websocket("/ws")
async def websocket_endpoint(websocket: WebSocket):
    user = _get_user_from_cookie(websocket)
    if not user:
        await websocket.close(code=4001)
        return
    await websocket.accept()
    dn = user.username
    try:
        conn = sqlite3.connect(_user_db())
        conn.row_factory = sqlite3.Row
        row = conn.execute("SELECT display_name FROM users WHERE username = ?", (user.username,)).fetchone()
        conn.close()
        if row and row["display_name"]:
            dn = row["display_name"]
    except Exception:
        pass
    _active_ws[user.username] = websocket
    _user_display[user.username] = dn
    _user_roles[user.username] = user.role
    log.info("WebSocket connected: user=%s display=%s", user.username, dn)
    await _broadcast_system(f"{dn} joined.", save=False)
    await _broadcast_online()
    try:
        while True:
            raw = await websocket.receive_text()
            try:
                data = json.loads(raw)
            except json.JSONDecodeError:
                continue
            if data.get("ping"):
                continue
            message = str(data.get("message", "")).strip()
            if not message:
                continue
            await _broadcast_user_msg(user.username, dn, user.role, message)
            try:
                from app.state_manager import get_state_manager
                if not get_state_manager().is_accepting_messages():
                    rest = f"CDCN Agent is in rest mode until {settings.wake_start_time}."
                    await _save_message("agent", "CDCN Agent", "agent", "agent", rest)
                    await _broadcast({"type": "token", "content": rest})
                    await _broadcast({"type": "done"})
                    continue
            except Exception:
                pass
            from app.gateway.router import _get_agent_router
            router = _get_agent_router()
            if not router:
                await _broadcast({"type": "error", "detail": "Agent not ready."})
                continue
            session_key = f"web:{user.username}"
            try:
                async for token in router.handle_message(
                    message=f"[{dn}]: {message}",
                    user_id=session_key,
                    role=user.role,
                    channel_id="web",
                ):
                    await _broadcast({"type": "token", "content": token})
                await _broadcast({"type": "done"})
            except Exception as exc:
                log.error("Router error: %s", exc)
                await _broadcast({"type": "error", "detail": "Error reaching language model."})
    except WebSocketDisconnect:
        pass
    finally:
        _active_ws.pop(user.username, None)
        _user_display.pop(user.username, None)
        _user_roles.pop(user.username, None)
        log.info("WebSocket disconnected: user=%s", user.username)
        await _broadcast_system(f"{dn} left.", save=False)
        await _broadcast_online()

class WebAdapter(BaseAdapter):
    async def start(self) -> None:
        log.info("WebAdapter: routes registered via web_router.")
    async def stop(self) -> None:
        log.info("WebAdapter: stopped.")
    async def send_message(self, channel_id: str, text: str) -> None:
        username = channel_id.replace("web:", "")
        ws = _active_ws.get(username)
        if ws:
            try:
                await ws.send_text(json.dumps({"type": "token", "content": text}))
                await ws.send_text(json.dumps({"type": "done"}))
            except Exception:
                pass
