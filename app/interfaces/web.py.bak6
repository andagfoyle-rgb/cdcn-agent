@web_router.post("/admin/reactivate")
async def admin_reactivate(request: Request):
    user = _get_user_from_cookie(request)
    if not user or not has_permission(user.role, "add_users"):
        return RedirectResponse(url="/", status_code=303)
    form = await request.form()
    reactivate_user(str(form.get("username", "")))
