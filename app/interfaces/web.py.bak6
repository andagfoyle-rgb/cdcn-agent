}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: var(--font); background: var(--bg-primary); color: var(--text-primary);
       height: 100vh; display: flex; flex-direction: column; transition: background .2s, color .2s; }

/* Header */
.header { background: var(--bg-header); color: var(--text-header); padding: .75rem 1.25rem;
          display: flex; align-items: center; gap: 1rem; flex-shrink: 0;
          border-bottom: 2px solid var(--sailing-blue); }
.header h1 { font-size: 1.1rem; font-weight: 600; flex: 1; letter-spacing: .02em; }
.status-badge { font-size: .75rem; padding: .2rem .6rem; border-radius: 12px;
                background: rgba(255,255,255,.15); font-weight: 500; }
.status-badge.wake { background: #22c55e; color: #fff; }
.status-badge.dream { background: #6366f1; color: #fff; }
