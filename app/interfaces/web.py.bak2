_JS = """\
(function () {
  'use strict';

  var messages  = document.getElementById('messages');
  var input     = document.getElementById('input');
  var sendBtn   = document.getElementById('send');
  var statusEl  = document.getElementById('status-badge');

  // ── WebSocket ────────────────────────────────────────────────────────────
  var proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
  var ws    = new WebSocket(proto + '//' + location.host + '/ws');

  ws.onopen = function () {
    appendMsg('system', 'Connected to CDCN Agent.');
    input.disabled = false;
    sendBtn.disabled = false;
  };

  ws.onclose = function () {
    appendMsg('system', 'Disconnected. Reload to reconnect.');
    input.disabled = true;
    sendBtn.disabled = true;
  };

  ws.onerror = function () {
    appendMsg('system', 'Connection error.');
  };

  // ── Message rendering ────────────────────────────────────────────────────
  var currentAgentEl = null;

  ws.onmessage = function (event) {
    var data;
    try { data = JSON.parse(event.data); } catch (e) { return; }

    if (data.type === 'token') {
      if (!currentAgentEl) {
        currentAgentEl = appendMsg('agent', '');
      }
      currentAgentEl.textContent += data.content;
      messages.scrollTop = messages.scrollHeight;

    } else if (data.type === 'done') {
      currentAgentEl = null;
      sendBtn.disabled = false;
      input.disabled = false;
      input.focus();

    } else if (data.type === 'error') {
      appendMsg('system', 'Error: ' + (data.detail || 'unknown'));
      sendBtn.disabled = false;
      input.disabled = false;
    }
  };

  function appendMsg(role, text) {
    var el = document.createElement('div');
    el.className = 'msg ' + role;
    el.textContent = text;
    messages.appendChild(el);
    messages.scrollTop = messages.scrollHeight;
    return el;
  }

  // ── Send ─────────────────────────────────────────────────────────────────
  function sendMessage() {
    var text = input.value.trim();
    if (!text || ws.readyState !== WebSocket.OPEN) return;
    appendMsg('user', text);
    ws.send(JSON.stringify({ message: text }));
    input.value = '';
    sendBtn.disabled = true;
    input.disabled = true;
  }

  sendBtn.addEventListener('click', sendMessage);

  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });

  // ── Status polling ───────────────────────────────────────────────────────
  function pollStatus() {
    fetch('/api/status')
      .then(function (r) { return r.json(); })
      .then(function (s) {
        var mode = (s.mode || 'unknown').replace(/_/g, '-');
        statusEl.textContent = mode;
        statusEl.className = 'status-badge ' + (s.mode || 'unknown');
      })
      .catch(function () {});
  }

  pollStatus();
  setInterval(pollStatus, 30000);
  // ── File upload ──────────────────────────────────────────────────────────
  var uploadInput = document.getElementById('upload-input');
  uploadInput.addEventListener('change', function () {
    var files = Array.from(uploadInput.files);
    if (!files.length) return;
    appendMsg('system', 'Uploading ' + files.length + ' file(s)...');
    var fd = new FormData();
    var readers = files.map(function(file) {
      return new Promise(function(resolve) {
        var reader = new FileReader();
        reader.onload = function(e) {
          var blob = new Blob([e.target.result], {type: file.type || 'application/octet-stream'});
          fd.append('files', blob, file.name);
          resolve();
        };
        reader.readAsArrayBuffer(file);
      });
    });
    Promise.all(readers).then(function() {
      fetch('/upload', { method: 'POST', body: fd })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          appendMsg('system', data.message || 'Upload complete.');
        })
        .catch(function () {
          appendMsg('system', 'Upload failed.');
        });
    });
    uploadInput.value = '';
  });
}());
"""


@web_router.get("/chat.css")
async def serve_css():
    return Response(content=_CSS, media_type="text/css; charset=utf-8")


@web_router.get("/chat.js")
async def serve_js():
    return Response(content=_JS, media_type="application/javascript; charset=utf-8")


